{
  "name": "finance-app-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS + MongoDB API for finance-app: storage, spreadsheet import/export and backups.",
  "scripts": {
    "build": "nest build",
    "prebuild": "npm run build -w @finance/shared",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test:cov"
  },
  "dependencies": {
    "@finance/shared": "*",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "mongoose": "9.11.3",
    "pdfjs-dist": "6.3.289",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.19.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "mongodb-memory-server": "11.3.0",
    "pdf-lib": "1.17.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "type": "module"
}
